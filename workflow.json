{

  "defaults": {

    "confidence": 0.8,

    "timeout": 15,

    "interval": 0.15,

    "move_duration": 0.01,

    "search_dir": "never",

    "dry_run": false,

    "show_debug": false,

    "scale_range": [1.0],

    "remember": true,

    "ocr_before": true,

    "ocr_lang": "lit",

    "ocr_required": false,

    "force_ocr": true,

    "ocr_skip_unchanged": true,

    "ocr_max_pages": 15,

    "ocr_dpi": 180,

    "ocr_early_stop": false,

    "ocr_workers": 4,

    "ignore_emails": [

      "info@.lt",

      "@.lt"

    ],

    "housekeep_every": 5,

    "debug_max_files": 80,

    "debug_max_age_hours": 12

  },

  "default_workflow": "upload",

  "workflows": {

    "upload": [

      { "type": "find_image", "template": "Screenshot_1.png", "move": true },

      { "type": "click" },



      { "type": "find_image", "template": "Screenshot_2.png", "move": true, "confidence": 0.9, "timeout": 20 },

      { "type": "click" },

      { "type": "wait", "seconds": 0.2 },



      { "type": "type_text", "text": "https://www.perplexity.ai/" },

      { "type": "wait", "seconds": 0.15 },

      { "type": "press_key", "key": "enter" },



      { "type": "find_image", "template": "Screenshot_3.png", "timeout": 20, "move": true, "required": true },

      { "type": "click" },

      { "type": "wait", "seconds": 0.2 },



      { "type": "type_text", "text": "{filename}" },

      { "type": "press_key", "key": "enter" }

    ]

  }

}

